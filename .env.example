# === Firecrawl (REQUIRED for live doc-drift, Change Tracking, Map, & Developer Index) ===
# Get your key at https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# === LLM Provider Chain (Vercel AI Gateway primary -> OpenAI fallback -> OpenRouter fallback) ===
# Primary: Vercel AI Gateway (auto-authenticated via VERCEL_OIDC_TOKEN on Vercel, or set key locally)
AI_GATEWAY_API_KEY=

# Fallback 1: OpenAI direct
OPENAI_API_KEY=

# Fallback 2: OpenRouter
OPENROUTER_API_KEY=

# === Hard Budget & Safety Caps ===
DEADCODEFIX_MAX_USD_CAP=50
DEADCODEFIX_MAX_FIRECRAWL_PAGES=20
